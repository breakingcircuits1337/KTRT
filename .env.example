# KTRT — Knights of the Round Table Research
# Copy to .env and fill in your credentials

# ── Inbound auth ──────────────────────────────────────────────
KTRT_API_KEY=your-secret-api-key-here

# ── Azure AI Foundry (PRIMARY — all roles default here) ────────
# portal.azure.com → your AI Foundry project → Settings → Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Check https://learn.microsoft.com/azure/ai-services/openai/api-version-deprecation
AZURE_OPENAI_API_VERSION=2025-01-01-preview
#
# The following deployment names must match exactly what you set in Azure AI Foundry.
# Each role uses a dedicated deployment; AZURE_OPENAI_DEPLOYMENT is the fallback only.
#
#  Role        Deployment name              Model
#  ─────────   ──────────────────────────   ────────────────────────────
#  researcher  deepseek-v3.2               DeepSeek V3.2
#  evidence    kimi-k2-thinking            Moonshot AI Kimi-K2 Thinking
#  planner     gpt-5.4-pro                 GPT-5.4 Pro
#  critic      deepseek-v3.2-speciale      DeepSeek V3.2-Speciale
#  judge       gpt-5.4-pro                 GPT-5.4 Pro
#  builder     gpt-5.1-codex-max           GPT-5.1 Codex Max
#  debugger    gpt-5.1-codex-max           GPT-5.1 Codex Max
#
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-pro

# ── Fallback / override providers (optional) ──────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Research providers ────────────────────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=

# ── Storage ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=<your-db-password>
DATABASE_URL=postgresql+asyncpg://ktrt:<your-db-password>@localhost:5432/ktrt

# ── Workflow defaults ─────────────────────────────────────────
MAX_DEBATE_ROUNDS=3
MAX_DEBUG_ROUNDS=3
DEFAULT_MODE=research

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to * (all). Restrict in production.
# Example: CORS_ORIGINS=https://app.example.com,https://gpt.example.com
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
