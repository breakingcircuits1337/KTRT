# KTRT — Knights of the Round Table Research
# Copy to .env and fill in your credentials

# ── Inbound auth ──────────────────────────────────────────────
KTRT_API_KEY=your-secret-api-key-here

# ── Azure AI Foundry (PRIMARY — all roles default here) ────────
# Obtain from: portal.azure.com → Azure OpenAI → Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Default deployment used when a role does not specify one explicitly.
# Deploy gpt-4.1 and gpt-4o in your Azure AI Foundry project.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# Check https://learn.microsoft.com/azure/ai-services/openai/api-version-deprecation
# for the latest stable / preview version string.
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── Fallback / override providers (optional) ──────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Research providers ────────────────────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=

# ── Storage ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=<your-db-password>
DATABASE_URL=postgresql+asyncpg://ktrt:<your-db-password>@localhost:5432/ktrt

# ── Workflow defaults ─────────────────────────────────────────
MAX_DEBATE_ROUNDS=3
MAX_DEBUG_ROUNDS=3
DEFAULT_MODE=research

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to * (all). Restrict in production.
# Example: CORS_ORIGINS=https://app.example.com,https://gpt.example.com
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
